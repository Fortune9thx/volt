# Frontend runtime config (safe to expose in the browser bundle -- Next.js
# requires the NEXT_PUBLIC_ prefix to inline a var into the client bundle)
NEXT_PUBLIC_GENLAYER_CHAIN=bradbury
NEXT_PUBLIC_VOLT_CONTRACT_ADDRESS=
NEXT_PUBLIC_VOLT_ESCROW_ADDRESS=
NEXT_PUBLIC_BASE_SEPOLIA_CHAIN_ID=84532
# Verify against Circle's own test-network docs before setting -- see
# evm/.env.example's identical note.
NEXT_PUBLIC_BASE_SEPOLIA_USDC_ADDRESS=

# Deployment-only secrets. NEVER prefix with NEXT_PUBLIC_ (that would ship
# them to the browser). Used only by scripts/deploy.mjs and
# scripts/relayer.mjs, run locally from the terminal -- never committed.
DEPLOYER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=

# Relayer script config (scripts/relayer.mjs)
VOLT_ESCROW_ADDRESS=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
RELAYER_POLL_INTERVAL_MS=15000
