# Base Sepolia's official Circle-issued USDC test token address -- verify
# against https://developers.circle.com/stablecoins/usdc-on-test-networks
# before deploying; never trust a hardcoded/memorized address.
BASE_SEPOLIA_USDC_ADDRESS=

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployment-only secret. Never committed.
EVM_DEPLOYER_PRIVATE_KEY=

# The address (not private key) that VoltEscrow will authorize as relayer.
# Defaults to the deployer's own address if unset.
RELAYER_ADDRESS=
